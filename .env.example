# PostgreSQL connection string. If using `docker compose up`, this is
# constructed automatically from POSTGRES_USER/PASSWORD/DB below — set
# this yourself only if connecting to a database outside Docker Compose.
DATABASE_URL=
 
# Used by docker-compose.yml to configure the local Postgres container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pokemoves
 
# Better Auth — generate a secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
 
# Resend — used for auth-related transactional email (verification,
# password reset, etc).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
 
# PokeAPI's GraphQL schema version. See https://pokeapi.co for current
# supported values.
NEXT_PUBLIC_POKEAPI_SCHEMA_MODE=v1beta2